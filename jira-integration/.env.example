# Copy this file to .env in the same folder and fill in real values.
# .env is gitignored (see .gitignore next to this file) - never commit it.

# Jira Cloud site base URL, no trailing slash
JIRA_BASE_URL=https://yourcompany.atlassian.net

# The Atlassian account email you generated the API token with
JIRA_EMAIL=you@example.com

# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# The project key tickets should be created under (e.g. VULNBANK, SEC, ...)
JIRA_PROJECT_KEY=

# Issue type name to use for each finding - must exist in your project's
# issue type scheme. "Bug" is the usual default; some teams use "Task" or
# a custom "Vulnerability" type.
JIRA_ISSUE_TYPE=Bug
